{
  "name": "codex-tencent-connectors",
  "version": "0.1.2",
  "description": "面向 Codex 的企业微信、QQ 邮箱和腾讯文档连接器插件。",
  "homepage": "https://github.com/Fortytwoo/codex-tencent-connectors#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fortytwoo/codex-tencent-connectors.git"
  },
  "bugs": {
    "url": "https://github.com/Fortytwoo/codex-tencent-connectors/issues"
  },
  "type": "module",
  "bin": {
    "codex-tencent-connectors": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugins",
    "scripts/build-plugin.mjs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-plugin.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/confirmation-store.test.js dist/errors.test.js dist/wecom-policy.test.js && node scripts/smoke-plugin.mjs",
    "smoke": "npm run build && node scripts/smoke-plugin.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@wecom/cli": "^0.1.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
